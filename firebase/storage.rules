rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(tenantId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.active == true;
    }

    function gmsSuperAdmin() {
      return request.auth != null && ('gmsSuperAdmin' in request.auth.token) && request.auth.token.gmsSuperAdmin == true;
    }

    function assignedAgent(tenantId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/agentUsers/$(request.auth.uid)/assignments/$(tenantId))
        && firestore.get(/databases/(default)/documents/agentUsers/$(request.auth.uid)/assignments/$(tenantId)).data.status == 'active';
    }

    function assignedBrand(tenantId, brandId) {
      let assignment = firestore.get(/databases/(default)/documents/agentUsers/$(request.auth.uid)/assignments/$(tenantId)).data;
      return assignedAgent(tenantId)
        && ((!('brandId' in assignment)) || assignment.brandId == null || assignment.brandId == brandId
          || (('brandIds' in assignment) && assignment.brandIds.hasAny([brandId])));
    }

    function supportedFile() {
      return request.resource != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|audio/.*|video/mp4|text/.*|application/json|application/zip|application/msword|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.*');
    }

    match /tenants/{tenantId}/brands/{brandId}/{allPaths=**} {
      allow read: if gmsSuperAdmin() || member(tenantId) || assignedBrand(tenantId, brandId);
      allow create, update: if (gmsSuperAdmin() || member(tenantId) || assignedBrand(tenantId, brandId)) && supportedFile();
      allow delete: if gmsSuperAdmin() || member(tenantId);
    }

    match /tenants/{tenantId}/documents/{documentId}/{allPaths=**} {
      allow read: if gmsSuperAdmin() || member(tenantId);
      // Registration seals the file. New creative versions use new document IDs.
      allow write: if (gmsSuperAdmin() || member(tenantId)) && supportedFile()
        && !firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/documents/$(documentId));
    }

    match /tenants/{tenantId}/{folder}/{allPaths=**} {
      allow read: if gmsSuperAdmin() || member(tenantId);
      allow create, update: if folder != 'documents' && (gmsSuperAdmin() || member(tenantId)) && supportedFile();
      allow delete: if folder != 'documents' && (gmsSuperAdmin() || member(tenantId));
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
