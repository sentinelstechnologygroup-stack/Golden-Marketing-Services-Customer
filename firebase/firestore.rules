rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function gmsSuperAdmin() {
      return signedIn() && request.auth.token.gmsSuperAdmin == true;
    }

    function membership(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.active == true;
    }

    function role(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role;
    }

    function agentAssigned(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/agentUsers/$(request.auth.uid)/assignments/$(tenantId))
        && grantIsActive(get(/databases/$(database)/documents/agentUsers/$(request.auth.uid)/assignments/$(tenantId)).data);
    }

    function grantIsActive(assignment) {
      return assignment.status == 'active'
        && (!('enabled' in assignment) || assignment.enabled == true)
        && (!('revokedAt' in assignment) || assignment.revokedAt == null)
        && (!('effectiveAt' in assignment) || assignment.effectiveAt == null || (assignment.effectiveAt is timestamp && assignment.effectiveAt <= request.time))
        && (!('expiresAt' in assignment) || (assignment.expiresAt is timestamp && assignment.expiresAt > request.time));
    }

    function agentBrandAllowed(tenantId) {
      let assignment = get(/databases/$(database)/documents/agentUsers/$(request.auth.uid)/assignments/$(tenantId)).data;
      let brands = assignment.get('brandIds', []);
      let brand = assignment.get('brandId', null);
      return (brand == null && brands.size() == 0)
        || (('brandId' in resource.data) && (resource.data.brandId == brand || brands.hasAny([resource.data.brandId])));
    }

    function canAccessTenant(tenantId) {
      return gmsSuperAdmin() || membership(tenantId) || agentAssigned(tenantId);
    }

    function tenantData(tenantId) {
      return request.resource.data.tenantId == tenantId;
    }

    function customerReadable(collection) {
      return collection in ['dashboard', 'leads', 'appointments', 'reports', 'billing', 'invoices', 'documents', 'support', 'supportRequests', 'notifications'];
    }

    function staffRole(tenantId) {
      return gmsSuperAdmin() || role(tenantId) in ['admin', 'supervisor', 'client_admin', 'client_supervisor', 'agent', 'auditor'];
    }

    function operationalCollection(collection) {
      return collection in ['leads', 'followUpTasks', 'communicationAlerts', 'callRecords', 'callTranscripts', 'callQualityReviews', 'appointments', 'businessOwners', 'reports'];
    }

    function configurationCollection(collection) {
      return collection in ['organizations', 'brands', 'campaigns', 'leadSources', 'scripts', 'qualificationForms', 'routingRules', 'phoneNumbers'];
    }

    // Communications and media always use fresh callable authorization.
    function communicationsCollection(collection) {
      return collection in ['callRecords', 'callTranscripts'];
    }

    match /tenants/{tenantId} {
      allow read: if canAccessTenant(tenantId);
      allow write: if gmsSuperAdmin() || (membership(tenantId) && role(tenantId) in ['admin', 'client_admin']);

      match /members/{uid} {
        allow read: if gmsSuperAdmin() || (membership(tenantId) && (uid == request.auth.uid || role(tenantId) in ['admin', 'supervisor', 'client_admin', 'client_supervisor']));
        allow write: if false;
      }

      match /auditLogs/{auditId} {
        allow read: if gmsSuperAdmin() || membership(tenantId) || agentAssigned(tenantId);
        allow write: if false;
      }

      match /{collection}/{documentId} {
        allow read: if canAccessTenant(tenantId)
          && (gmsSuperAdmin() || (collection != 'integrations' && !(collection == 'config' && documentId == 'onboarding')))
          && !communicationsCollection(collection)
          && !(collection == 'followUpTasks' && resource.data.get('task_type', '') in ['callback', 'callback_reminder'])
          && collection != 'members'
          && collection != 'auditLogs'
          && (!agentAssigned(tenantId) || gmsSuperAdmin() || membership(tenantId) || agentBrandAllowed(tenantId))
          && (gmsSuperAdmin() || agentAssigned(tenantId) || (membership(tenantId) && (role(tenantId) in ['admin', 'supervisor', 'client_admin', 'client_supervisor', 'auditor'] || (role(tenantId) in ['customer', 'client'] && customerReadable(collection)))));
        allow create: if membership(tenantId)
          && !(collection == 'followUpTasks' && request.resource.data.get('task_type', '') in ['callback', 'callback_reminder'])
          && collection != 'phoneNumbers'
          && !communicationsCollection(collection)
          && collection != 'members'
          && collection != 'auditLogs'
          && tenantData(tenantId)
          && ((role(tenantId) in ['admin', 'supervisor', 'client_admin', 'client_supervisor'] && operationalCollection(collection))
            || (role(tenantId) in ['admin', 'supervisor', 'client_admin', 'client_supervisor'] && configurationCollection(collection))
            || (role(tenantId) in ['admin', 'client_admin'] && collection in ['support', 'documents']));
        allow update: if membership(tenantId)
          && !(collection == 'followUpTasks' && (resource.data.get('task_type', '') in ['callback', 'callback_reminder'] || request.resource.data.get('task_type', '') in ['callback', 'callback_reminder']))
          && collection != 'phoneNumbers'
          && (!('managedBy' in resource.data) || resource.data.managedBy != 'onboarding')
          && !communicationsCollection(collection)
          && collection != 'members'
          && collection != 'auditLogs'
          && resource.data.tenantId == tenantId
          && tenantData(tenantId)
          && ((role(tenantId) in ['admin', 'supervisor', 'client_admin', 'client_supervisor'] && operationalCollection(collection))
            || (role(tenantId) in ['admin', 'supervisor', 'client_admin', 'client_supervisor'] && configurationCollection(collection))
            || (role(tenantId) in ['admin', 'client_admin'] && collection in ['support', 'documents']));
        allow delete: if membership(tenantId)
          && !(collection == 'followUpTasks' && resource.data.get('task_type', '') in ['callback', 'callback_reminder'])
          && collection != 'phoneNumbers'
          && !(collection in ['config', 'integrations', 'campaignApprovals'])
          && (!('managedBy' in resource.data) || resource.data.managedBy != 'onboarding')
          && !communicationsCollection(collection)
          && collection != 'members'
          && collection != 'auditLogs'
          && role(tenantId) in ['admin', 'client_admin'];
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || gmsSuperAdmin());
      allow write: if false;
    }

    match /agentUsers/{uid} {
      allow read, write: if false;
      match /assignments/{tenantId} {
        // Legacy assignments may still contain provider credential identifiers.
        // Only the sanitized getMyProfile/permissions callables expose grants.
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
